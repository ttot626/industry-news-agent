# ===== 智能资讯问答 Agent - 环境变量示例 =====
# 复制为 .env.development 后填写真实值，切勿提交含密钥的文件

APP_ENV=development
PROJECT_NAME="智能资讯问答 Agent"
VERSION=1.0.0
DEBUG=true

API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# DeepSeek（OpenAI 兼容接口）
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_TEMPERATURE=0.3
MAX_TOKENS=2000

# 长期记忆（可选；无 embedding 时可不依赖）
LONG_TERM_MEMORY_MODEL=deepseek-chat
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small

LANGFUSE_TRACING_ENABLED=false

# JWT：生产环境请换成随机长串
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# PostgreSQL（Docker Compose 本地开发）
POSTGRES_HOST=localhost
POSTGRES_DB=resume_agent_db
POSTGRES_USER=resume_user
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

LOG_LEVEL=INFO
LOG_FORMAT=console
SESSION_NAMING_ENABLED=true
